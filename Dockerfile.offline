# Offline runtime image. It uses only local build inputs and FROM scratch, so
# docker build --network none neither pulls nor contacts a registry.
# Inputs are generated by scripts/offline-build.sh:
#   build/offline/qmi-web
#   build/offline/qmi-probe
#   build/offline/qmi-dbcheck
#   build/offline/qmi-backup
#   build/offline/ca-certificates.crt
FROM scratch
ARG VERSION=1.0.0
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
LABEL org.opencontainers.image.title="QMI Web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.licenses="MIT"
WORKDIR /
COPY build/offline/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY build/offline/qmi-web /qmi-web
COPY build/offline/qmi-probe /qmi-probe
COPY build/offline/qmi-dbcheck /qmi-dbcheck
COPY build/offline/qmi-backup /qmi-backup
USER 65532:65532
EXPOSE 7580
ENTRYPOINT ["/qmi-web"]
