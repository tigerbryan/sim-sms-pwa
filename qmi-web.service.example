[Unit]
Description=QMI Web SMS Management Interface
After=network.target ModemManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qmi-web
ExecStart=/opt/qmi-web/bin/qmi-web --data /opt/qmi-web/data --config /opt/qmi-web/config.yaml

# Automatic restart
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# ProtectSystem=full is usually safe but we need to write to /opt/qmi-web/data
ProtectSystem=full
ReadWritePaths=/opt/qmi-web/data

[Install]
WantedBy=multi-user.target
