{
  "name": "qmi-web-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node ./scripts/check-version-source.mjs && vue-tsc --noEmit && vite build && node ./scripts/stamp-pwa-release.mjs",
    "check:version-source": "node ./scripts/check-version-source.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "date-fns": "^4.4.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "4.0.2",
    "vue": "3.5.43",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "unplugin-utils": "0.3.2"
  }
}
